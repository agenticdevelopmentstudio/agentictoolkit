{
  "name": "@agentic-toolkit/status-web",
  "version": "0.1.0",
  "description": "A status monitor's operator dashboard: React panels, hooks and the browser-side API client. A Next host mounts these in its own pages, providers and proxy.",
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "development": "./src/index.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./header-auth": {
      "types": "./dist/header-auth.d.ts",
      "development": "./src/header-auth.ts",
      "import": "./dist/header-auth.js",
      "default": "./dist/header-auth.js"
    },
    "./api/client": {
      "types": "./dist/api/client.d.ts",
      "development": "./src/api/client.ts",
      "import": "./dist/api/client.js",
      "default": "./dist/api/client.js"
    },
    "./components/*": {
      "types": "./dist/components/*.d.ts",
      "development": "./src/components/*.tsx",
      "import": "./dist/components/*.js",
      "default": "./dist/components/*.js"
    },
    "./lib/*": {
      "types": "./dist/lib/*.d.ts",
      "development": "./src/lib/*.ts",
      "import": "./dist/lib/*.js",
      "default": "./dist/lib/*.js"
    },
    "./styles/panels.css": "./src/styles/panels.css",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsup && pnpm run build:types",
    "build:types": "tsc --emitDeclarationOnly -p tsconfig.build.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run"
  },
  "comment:dependencies": "`link:`, not `workspace:*`: agenticdevelopertoolkit is a SEPARATE pnpm workspace reached through this repo's own submodule, and pnpm cannot nest workspaces. Same shape as adh-ui, api-explorer and persona — four levels up from packages/web/packages/<pkg>.",
  "dependencies": {
    "@agentic-toolkit/deploy-platform": "workspace:*",
    "@agenticdevelopertoolkit/themes": "link:../../../../external/agenticdevelopertoolkit/packages/web/packages/themes",
    "@agenticdevelopertoolkit/ui": "link:../../../../external/agenticdevelopertoolkit/packages/web/packages/ui",
    "lucide-react": "^1.16.0"
  },
  "peerDependencies": {
    "@tanstack/react-query": "^5.62.0",
    "next": ">=15",
    "react": "^19",
    "react-dom": "^19"
  },
  "comment:devDependencies": "The runtime deps of the linked @agenticdevelopertoolkit/ui are repeated here so vitest's adtAlias (../../vitest.adt.ts) can pin them to THIS package's copy — one React, one clsx — in the test process. Same shape as api-explorer and adh-ui.",
  "devDependencies": {
    "@agentic-toolkit/status-server": "workspace:*",
    "@base-ui/react": "1.5.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@tanstack/react-query": "^5.62.0",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@types/node": "^24.0.0",
    "@types/react": "19.2.16",
    "@types/react-dom": "19.2.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "esbuild-plugin-preserve-directives": "^0.0.11",
    "harper.js": "^2.4.0",
    "jsdom": "^29.0.0",
    "next": "^16.2.9",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tailwind-merge": "^2.6.0",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2",
    "vitest": "^4.1.4"
  }
}
