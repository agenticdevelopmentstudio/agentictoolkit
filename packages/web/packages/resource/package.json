{
  "name": "@agentic-toolkit/resource",
  "version": "0.1.0",
  "description": "Generic resource-browsing UI: ResourceExplorer, landing/dialog/master-detail, and the rail-host & record-affordance host seams.",
  "license": "UNLICENSED",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "sources.css"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "comment:exports": "`development` → src for `next dev` (HMR); prod skips it → dist. `./sources.css` is the Tailwind @source self-registration a host @imports once.",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "development": "./src/index.ts",
      "import": "./dist/index.js"
    },
    "./testing": {
      "types": "./dist/testing/index.d.ts",
      "development": "./src/testing/index.ts",
      "import": "./dist/testing/index.js"
    },
    "./sources.css": "./sources.css"
  },
  "scripts": {
    "build": "tsup && pnpm run build:types",
    "build:types": "tsc --emitDeclarationOnly -p tsconfig.build.json",
    "dev": "tsup --watch",
    "clean": "rm -rf dist",
    "lint": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@agentic-toolkit/auth": "workspace:*",
    "@agentic-toolkit/data": "workspace:*",
    "@base-ui/react": "1.5.0",
    "lucide-react": "^1.16.0",
    "@agenticdevelopertoolkit/ui": "link:../../../../external/agenticdevelopertoolkit/packages/web/packages/ui"
  },
  "peerDependencies": {
    "next": ">=15",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/react": "19.2.16",
    "@types/react-dom": "19.2.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "esbuild-plugin-preserve-directives": "^0.0.11",
    "harper.js": "^2.4.0",
    "jsdom": "^29.0.2",
    "next": "^15.1.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "tailwind-merge": "^2.6.0",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2",
    "vitest": "^4.1.4"
  }
}
