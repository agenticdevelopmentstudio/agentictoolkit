{
  "name": "@agentic-toolkit/research",
  "version": "0.1.0",
  "description": "The Research feature: markdown research documents — search, editor, publish flow.",
  "license": "UNLICENSED",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "sources.css"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "comment:exports": "`development` → src for `next dev` (HMR); prod skips it → dist. `./sources.css` is the Tailwind @source self-registration a host @imports once.",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "development": "./src/index.ts",
      "import": "./dist/index.js"
    },
    "./sources.css": "./sources.css",
    "./parse": {
      "types": "./dist/parse-path.d.ts",
      "development": "./src/parse-path.ts",
      "import": "./dist/parse-path.js"
    }
  },
  "scripts": {
    "build": "tsup && pnpm run build:types && pnpm run check:directives",
    "build:types": "tsc --emitDeclarationOnly -p tsconfig.build.json",
    "dev": "tsup --watch",
    "clean": "rm -rf dist",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "check:directives": "python3 ../tools/check-directives.py"
  },
  "dependencies": {
    "@agentic-toolkit/auth": "workspace:*",
    "@agentic-toolkit/categories": "workspace:*",
    "@agentic-toolkit/crud": "workspace:*",
    "@agentic-toolkit/data": "workspace:*",
    "@agentic-toolkit/resource": "workspace:*",
    "lucide-react": "^1.16.0",
    "@agenticdevelopertoolkit/markdown": "link:../../../../../external/adhsdk/packages/web/packages/markdown",
    "@agenticdevelopertoolkit/ui": "link:../../../../../external/adhsdk/packages/web/packages/ui"
  },
  "peerDependencies": {
    "next": ">=15",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@base-ui/react": "1.5.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@shikijs/rehype": "^1.0.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/react": "19.2.16",
    "@types/react-dom": "19.2.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "esbuild-plugin-preserve-directives": "^0.0.11",
    "gray-matter": "^4.0.3",
    "harper.js": "^2.4.0",
    "jsdom": "^29.0.2",
    "next": "^15.1.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "rehype-autolink-headings": "^7.0.0",
    "rehype-sanitize": "^6.0.0",
    "rehype-slug": "^6.0.0",
    "rehype-stringify": "^10.0.0",
    "remark-gfm": "^4.0.0",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.0.0",
    "shiki": "^1.0.0",
    "tailwind-merge": "^2.6.0",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2",
    "unified": "^11.0.0",
    "vitest": "^4.1.4",
    "yaml": "^2.9.0"
  },
  "comment:directives": "`./parse` is the URL grammar an RSC host page CALLS, so it must stay directive-free TRANSITIVELY: `@agentic-toolkit/*` stays external in this build, so whatever it imports is resolved inside the caller's server component. The one allowed import is the categories package's own server-safe entry.",
  "directives": {
    "index": "client",
    "parse-path": [
      "@agentic-toolkit/categories/chain"
    ]
  }
}
